# Copy to .env locally. Never send or commit real credentials.
# NVR_HOST is a hostname/IP only, without scheme, path or credentials.
NVR_HOST=
NVR_HTTP_PORT=80
NVR_HTTP_SCHEME=http
NVR_RTSP_PORT=554
NVR_USERNAME=
NVR_PASSWORD=
# Recording dates and display default to UTC+8 (Beijing time).
NVR_TIME_ZONE=Asia/Shanghai
# Recording search wire format: this firmware uses local wall time with a Z suffix.
# Use utc for firmware that implements standard UTC recording timestamps.
NVR_RECORDING_TIME_MODE=device-local
NVR_TIMEOUT_MS=8000

# Install binaries separately. ffprobe is for P1 diagnosis.
# FFmpeg is also required by preview runtime for video stream-copy remux only.
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
