# Copy to .env locally. Never send or commit real credentials.
# NVR_HOST is a hostname/IP only, without scheme, path or credentials.
NVR_HOST=
NVR_HTTP_PORT=80
NVR_HTTP_SCHEME=http
NVR_RTSP_PORT=554
NVR_USERNAME=
NVR_PASSWORD=
NVR_TIME_ZONE=Asia/Shanghai
NVR_TIMEOUT_MS=8000

# P1 local CLI only. Binaries must be installed separately.
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
